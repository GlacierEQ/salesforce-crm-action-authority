    {"threat": "implicit irreversible send", "test": "test_external_send_requires_explicit_irreversible_authority"},
    {"threat": "actor grant borrowing", "test": "test_wrong_actor_cannot_borrow_grant"},
    {"threat": "workflow grant borrowing", "test": "test_wrong_subject_cannot_borrow_grant"},
    {"threat": "object scope expansion", "test": "test_wrong_object_cannot_borrow_grant"},
    {"threat": "action scope expansion", "test": "test_wrong_action_cannot_borrow_grant"},
    {"threat": "expired capability", "test": "test_expired_grant_fails_closed"},
    {"threat": "future capability", "test": "test_future_grant_fails_closed"},
    {"threat": "non-canonical numeric payload", "test": "test_non_finite_payload_is_rejected"},
